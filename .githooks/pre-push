#!/bin/sh
# Reject pushes to main, and reject branch names that do not match
# <type>/<kebab-desc>.
#
# Usage: pre-push <remote> <url>   (invoked by git; refs arrive on stdin)

set -eu

types='feat|fix|docs|chore|refactor|test|perf|ci|build'

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "$remote_ref" ] || continue

	case "$remote_ref" in
	refs/heads/*) ;;
	*) continue ;;
	esac

	branch=${remote_ref#refs/heads/}

	if [ "$branch" = "main" ]; then
		echo "pre-push: direct pushes to main are not allowed" >&2
		echo "pre-push: push a <type>/<kebab-desc> branch and open a pull request" >&2
		status=1
		continue
	fi

	if ! printf '%s\n' "$branch" | grep -Eq "^($types)/[a-z0-9]+(-[a-z0-9]+)*$"; then
		echo "pre-push: branch name does not match <type>/<kebab-desc>" >&2
		echo "pre-push: types are: feat fix docs chore refactor test perf ci build" >&2
		echo "pre-push: got: $branch" >&2
		status=1
	fi
done

exit "$status"
